{
  "tasks": {
    "dev": "deno serve --watch --allow-net=localhost:8000,localhost:5432 --allow-read --allow-env --allow-sys=hostname,networkInterfaces --env -R main.ts",
    "test": "deno test --allow-net",
    "prisma": "deno run -A npm:prisma"
  },
  "imports": {
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.7.6",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.4.0",
    "@prisma/client": "npm:@prisma/client@^7.4.0",
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "bcryptjs": "npm:bcryptjs@^3.0.3",
    "dotenv": "npm:dotenv@^17.3.1",
    "hono": "npm:hono@^4.11.10",
    "hono/cookie": "npm:hono/cookie",
    "hono/factory": "npm:hono/factory",
    "nodemailer": "npm:nodemailer@^8.0.1",
    "pg": "npm:pg@^8.18.0",
    "prisma": "npm:prisma@^7.4.0",
    "jose": "npm:jose@^6.1.3",
    "zod": "npm:zod@^4.3.6"
  },
  "nodeModulesDir": "auto",
  "allowScripts": {
    "allow": ["npm:@prisma/engines@7.4.0", "npm:prisma@7.4.0"],
  }
}
