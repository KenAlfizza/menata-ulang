{
  "tasks": {
    "dev": "deno serve --watch --allow-net=localhost:8000,localhost:5432 --allow-read --allow-env --allow-sys=hostname,networkInterfaces --env -R main.ts",
    "test": "deno test --allow-net",
    "prisma": "deno run -A npm:prisma"
  },
  "imports": {
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.8.0",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.8.0",
    "@prisma/client": "npm:@prisma/client@^7.8.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "bcryptjs": "npm:bcryptjs@^3.0.3",
    "dotenv": "npm:dotenv@^17.4.2",
    "hono": "npm:hono@^4.12.19",
    "hono/cookie": "npm:hono@4.12.19/cookie",
    "hono/factory": "npm:hono@4.12.19/factory",
    "nodemailer": "npm:nodemailer@^8.0.7",
    "pg": "npm:pg@^8.21.0",
    "prisma": "npm:prisma@^7.8.0",
    "jose": "npm:jose@^6.2.3",
    "zod": "npm:zod@^4.4.3",
    "path": "jsr:@std/path@1.1.4"
  },
  "nodeModulesDir": "auto",
  "allowScripts": ["npm:@prisma/engines@7.4.0", "npm:@prisma/engines@7.8.0", "npm:prisma@7.4.0", "npm:prisma@7.8.0"]
}
