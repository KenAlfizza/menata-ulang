// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  tokens    Token[]
  stories   Story[]
  deletedAt DateTime?
}

enum UserRole {
  SUPERUSER
  AUTHOR
  USER
}

model Token {
  id                  Int       @id @default(autoincrement())
  token               String    @unique
  type                TokenType
  userId              Int
  user                User      @relation(fields: [userId], references: [id])
  expiresAt           DateTime
  lastAccessTokenAt   DateTime  @default(now())
  createdAt           DateTime  @default(now())
}

enum TokenType {
  REFRESH
  RESET
}

model Story {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  text        String
  createdAt   DateTime  @default(now())
  author      User      @relation(fields: [authorId], references: [id])
  imageUrl    String    @default("")
  published   Boolean   @default(false)
  publishedAt DateTime?  
  // researchId
  // reflectionId
}