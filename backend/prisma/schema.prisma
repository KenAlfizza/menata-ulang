// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String?   // Optional for anonymous
  name        String    @default("Anonymous")
  role        UserRole  @default(USER)
  isAnonymous Boolean   @default(false)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime? 

  // Relationships
  tokens      Token[]
  stories     Story[]
  podcasts    Podcast[]
  reflections Reflection[]

  storypages  StoryPage[]
  researchpages ResearchPage[]
  
  /// Hearts given by this user across different content types.
  hearts      Heart[]
}

enum UserRole {
  SUPERUSER
  AUTHOR
  MODERATOR
  USER
}

model Token {
  id                Int       @id @default(autoincrement())
  token             String    @unique
  type              TokenType
  userId            Int
  user              User      @relation(fields: [userId], references: [id])
  expiresAt         DateTime
  lastAccessTokenAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
}

enum TokenType {
  REFRESH
  RESET
}

model Story {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  text        String
  createdAt   DateTime  @default(now())
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id])
  imageUrl    String    @default("")
  published   Boolean   @default(false)
  publishedAt DateTime?   
  research    Research?

  // Updated Thread Relation (Strict 1-to-1)
  // Connects this Story directly to a dedicated Thread container
  threadId    String     @unique
  thread      Thread     @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// Cached counter for total hearts received by this story.
  heartsCount Int        @default(0)

  /// Relation link to individual heart records.
  hearts      Heart[]
}

model Research {
  id        Int       @id @default(autoincrement())
  text      String
  storyId   Int       @unique   
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)   
}

model Podcast {
  id          Int       @id @default(autoincrement())
  title       String           
  description String      
  duration    Int
  audioUrl    String    @default("")
  imageUrl    String    @default("")
  listener    Int       @default(0)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  // Host Relation
  hostId      Int
  host        User      @relation(fields: [hostId], references: [id])

  // Updated Thread Relation (Strict 1-to-1)
  // Connects this Podcast directly to a dedicated Thread container
  threadId    String    @unique
  thread      Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// Cached counter for total hearts received by this podcast.
  heartsCount Int       @default(0) 

  /// Relation link to individual heart records.
  hearts      Heart[]
}

// Dedicated container model for managing conversational streams
model Thread {
  id          String       @id @default(uuid(7)) // Thread ID shared seamlessly with parents
  createdAt   DateTime     @default(now())

  // Inverse 1-to-1 relations mapping back to content types
  podcast     Podcast?
  story       Story?

  // A Thread owns many individual Reflection comments/replies
  reflections Reflection[]
}

model Reflection {
  id          String   @id @default(uuid(7)) 
  text        String      
  createdAt   DateTime @default(now())

  // Automatically updates timestaps when there is any change
  updatedAt   DateTime @updatedAt

  // User Relation
  userId      Int?
  userName    String          
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Master Thread Cluster Relation
  // Ties every comment and reply directly back to its container Thread
  threadId    String       
  thread      Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // Recursive Self-Relation for Nested Comment Trees (unchanged but fully compatible)
  parentId    String?
  parent      Reflection?  @relation("ThreadBranch", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Reflection[] @relation("ThreadBranch")

  /// Cached counter for total hearts received by this reflection.
  heartsCount Int      @default(0) 

  /// Relation link to individual heart records.
  hearts      Heart[]

  // Database Indexing for Blazing-Fast Pagination
  @@index([threadId, parentId, id])
}

model RateLimit {
  id       String   @id @default(uuid(7))
  ip       String   @unique
  count    Int      @default(1)
  reset    DateTime
  created  DateTime @default(now())
  updated  DateTime @updatedAt
}

/// A universal "Heart" (like) join table linking users to various content types.
/// A single heart record can only belong to one piece of content.
model Heart {
  id        String   @id @default(uuid())
  
  /// The timestamp when the user hearted the content.
  createdAt DateTime @default(now())

  /// The ID of the user that performed the heart operation.
  userId    Int
  /// User link relation.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The ID of the target Story (optional).
  storyId   Int?
  /// Story link relation.
  story     Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  
  /// The ID of the target Podcast (optional).
  podcastId Int?
  /// Podcast link relation.
  podcast   Podcast? @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  
  /// The ID of the target Reflection (optional).
  reflectionId String?
  /// Reflection link relation.
  reflection   Reflection? @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
  
  // Composite unique constraints to ensure a user can only heart a specific item once.
  @@unique([userId, storyId], name: "user_story_heart_unique")
  @@unique([userId, podcastId], name: "user_podcast_heart_unique")
  @@unique([userId, reflectionId], name: "user_reflection_heart_unique")
}

model Feedback {
  id          String   @id @default(uuid(7))
  userName    String  
  email       String  
  content     String   @db.Text
  resolved    Boolean  @default(false) // Added resolved flag
  createdAt   DateTime @default(now())
}

model StoryPage {
  id          String   @id @default(cuid(2)) // Backend-generated CUID
  title       String
  slug        String   @unique
  puckData    Json     // Saves the flexible layout schema from Puck editor
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
}

model ResearchPage {
  id          String   @id @default(cuid(2)) // Backend-generated CUID
  title       String
  description String
  slug        String   @unique
  puckData    Json     // Saves the flexible layout schema from Puck editor
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  researcherId    Int
  researcher      User     @relation(fields: [researcherId], references: [id])
}

